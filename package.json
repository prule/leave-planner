{
  "name": "leave-planner",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "npm run build:cf",
    "build:cf": "vue-tsc -b && vite build --base=/",
    "build:gh": "vue-tsc -b && vite build --base=/leave-planner/",
    "preview": "vite preview",
    "deploy": "npm run deploy:cf && npm run deploy:gh",
    "deploy:cf": "npm run build:cf && wrangler pages deploy dist",
    "deploy:gh": "npm run build:gh && gh-pages -d dist"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-chartjs": "^5.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@vitejs/plugin-vue": "6.0.4",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "7.3.1",
    "vite-plugin-pwa": "1.2.0",
    "vue-tsc": "^3.2.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.112.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
